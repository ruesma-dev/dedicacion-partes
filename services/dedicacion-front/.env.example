# .env  (copiar a .env; .env NUNCA se commitea ni entra en Docker)
FRONT_HOST=127.0.0.1
FRONT_PORT=8080
LOG_LEVEL=INFO

# URL interna del backend dedicacion-api.
# En Azure: http://<fqdn-interno-de-ca-dedicacion-api> (ingress INTERNO, http
# plano; lo cablea infra/create_front_dedicacion.ps1).
API_BASE_URL=http://127.0.0.1:8090

# Timeout del front hacia la api.
# En Azure se despliega API_TIMEOUT_S=200: cada salto espera MAS que el
# siguiente (front 200 s >= api->transfer 180 s) y todos por debajo del corte
# del balanceador de Azure, que son 230 s. Con los 120 s de aqui, desplegado,
# el front se rendiria ANTES que la api y el usuario veria un error de un
# registro que si se estaba haciendo (F-008, R28).
API_TIMEOUT_S=120

# Usuario en local (en Azure lo aporta Easy Auth).
# En Azure se despliega DEFAULT_USER=desconocido: si llegara una peticion sin
# cabecera de Easy Auth, la auditoria debe registrar que el usuario NO se
# identifico, y no un nombre que parece legitimo (F-008, R12).
DEFAULT_USER=local
