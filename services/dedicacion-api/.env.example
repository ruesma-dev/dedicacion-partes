# .env.example  (copiar a .env y rellenar; .env NUNCA se commitea ni entra en Docker)

# --- API ---
API_HOST=127.0.0.1
API_PORT=8090
LOG_LEVEL=INFO

# --- PostgreSQL aplicación ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=dedicacion
PG_USER=dedicacion_app
PG_PASSWORD=
PG_SSLMODE=prefer

# --- PostgreSQL admin (crea la BBDD si no existe) ---
# SOLO en local. En Azure NO se despliegan estas tres: con
# AUTO_CREATE_DATABASE=false el servicio no abre la conexion de
# administracion, y lo que no se guarda no se filtra.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
PG_ADMIN_DB=postgres

# Bootstrap de la BBDD al arrancar (CREATE ROLE + CREATE DATABASE).
# Aqui true: en el portatil es una comodidad.
# En Azure se despliega false (infra/create_api_dedicacion.ps1): la base vive
# en el servidor COMPARTIDO psql-albaranes-rs9k2 y la crea una persona, una
# sola vez, con infra/crear_base_dedicacion.ps1.
AUTO_CREATE_DATABASE=true

# --- Sigrid API (Function App) ---
SIGRID_API_BASE_URL=
SIGRID_API_FUNCTION_KEY=
SIGRID_API_DATABASE=ruesma
SIGRID_API_TIMEOUT_S=60
SIGRID_MAX_ROWS=5000

# --- dedicacion-transfer (registro en Sigrid) ---
# El codigo las lee desde siempre; el ejemplo no las declaraba.
TRANSFER_BASE_URL=http://127.0.0.1:8006
# Timeout de la api hacia el transfer. Cada salto espera MAS que el
# siguiente, y todos por debajo del corte del balanceador de Azure (230 s):
# front->api 200 s >= api->transfer 180 s >= transfer->sigrid-api 60 s.
# Al reves, el de fuera se rinde antes y el usuario ve un error de una
# escritura que si se estaba haciendo (F-008, R28).
TRANSFER_TIMEOUT_S=180
