# .env.example  (copiar a .env y rellenar; .env NUNCA se commitea ni entra en Docker)

# --- API ---
API_HOST=127.0.0.1
API_PORT=8090
LOG_LEVEL=INFO

# --- PostgreSQL aplicación ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=dedicacion
PG_USER=dedicacion_app
PG_PASSWORD=
PG_SSLMODE=prefer

# --- PostgreSQL admin (crea la BBDD si no existe) ---
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
PG_ADMIN_DB=postgres

# --- Sigrid API (Function App) ---
SIGRID_API_BASE_URL=
SIGRID_API_FUNCTION_KEY=
SIGRID_API_DATABASE=ruesma
SIGRID_API_TIMEOUT_S=60
SIGRID_MAX_ROWS=5000
