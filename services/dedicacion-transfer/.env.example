# .env — copiar a .env y completar
SIGRID_API_BASE_URL=
SIGRID_API_FUNCTION_KEY=
SIGRID_API_DATABASE=ruesma

# Modo pruebas: TODAS las escrituras van a la obra de pruebas
OBRA_PRUEBAS_FORZAR=true
OBRA_PRUEBAS_COD=0404
MARCA_PRUEBAS=PRUEBA-PORC

# La postventa se registra en la obra de postventa; el capitulo es la obra original
POSTVENTA_REGISTRAR=true
POSTVENTA_OBRA_COD=POSTV2

# Estados del parte (con.est). Un parte que no esta En registro (1) esta
# cerrado y no se toca: las lineas van a un complementario. Los otros dos
# solo dan nombre al estado en los avisos (F-037).
EST_PARTE_ACTIVO=1
EST_PARTE_CERRADO=3
EST_PARTE_IMPUTADO=10

API_HOST=0.0.0.0
API_PORT=8006
LOG_LEVEL=INFO

# Directorio del log de fichero (config/logging_config.py lo crea al arrancar).
# En Azure se despliega LOG_DIR=/tmp/logs: /app no tiene por que ser escribible
# dentro del contenedor.
LOG_DIR=logs
